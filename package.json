    "codemirror": "^6.0.2",
    "docx": "^9.16.0",
    "gray-matter": "^4.0.3",
    "i18next": "^27.2.4",
    "katex": "^0.19.1",
    "lucide-react": "^1.78.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
