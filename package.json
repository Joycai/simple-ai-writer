{
  "name": "simple-ai-writer",
  "private": true,
  "version": "2.0.30",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && pnpm prototypes:build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:appstore": "node scripts/build-appstore.mjs",
    "prototypes:dev": "vite --config prototypes/vite.config.mjs",
    "prototypes:check": "tsc --project prototypes/tsconfig.json --noEmit",
    "prototypes:build": "pnpm prototypes:check && vite build --config prototypes/vite.config.mjs",
    "prototypes:preview": "vite preview --config prototypes/vite.config.mjs",
    "audit:appstore": "node scripts/audit-appstore.mjs",
    "tauri:macos:release": "node scripts/build-macos-release.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
