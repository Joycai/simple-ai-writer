{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.simple-ai-writer.app.appstore",
  "productName": "Simple AI Writer Store",
  "build": {
    "features": [
      "app-store"
    ]
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "macOS": {
      "entitlements": "Entitlements.appstore.plist",
      "minimumSystemVersion": "14.0"
    }
  },
  "app": {
    "security": {
      "csp": {
        "connect-src": "'self' ipc: http://ipc.localhost",
        "form-action": "'none'",
        "base-uri": "'self'"
      }
    }
  }
}
