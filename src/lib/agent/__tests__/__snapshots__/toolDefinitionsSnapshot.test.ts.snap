    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "read_workflow",
   "description": "Read the step-by-step procedure of one workflow card from the 可用工作流 list in your instructions. When the author's request matches a card's description, call this FIRST and follow the steps. Cards are house procedure, advisory: the author's explicit instructions in chat always win over a card.",
   "parameters": {
    "type": "object",
    "properties": {
