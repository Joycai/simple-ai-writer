 },
 {
  "type": "function",
  "function": {
   "name": "read_lore_entity",
   "description": "Read a lore entity: its index.md and supplementary .md files, with per-file line numbers. A very large entry comes back as index.md plus a table of its other files — pass 'file' to read one of those (paged; 'start_line' continues). The entity may also have a gallery (avatar + images.md listing additional pictures with descriptions and image slots) — this only returns filenames and text descriptions, never the images themselves. The listing says whether anything on this run can open one, and how. Call list_lore_entities first to get the exact entity names.",
   "parameters": {
    "type": "object",
    "properties": {
     "entity": {
      "type": "string",
      "description": "Entity name exactly as returned by list_lore_entities"
     },
     "file": {
